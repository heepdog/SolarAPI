APPSYSTEMS_APP_ID=your_app_id
APPSYSTEMS_APP_SECRET=your_app_secret
APPSYSTEMS_SYSTEM_ID=your_system_id

# Optional: set this to the timezone used by your APsystems system.
# APPSYSTEMS_TIMEZONE=America/Los_Angeles

# Required by emailalert.sendalert() when sending email.
ALERT_RECIPIENT=your_alert_recipient@example.com

# Optional legacy IFTTT webhook URL. Keep the actual URL in .env, not in source.
# IFTTT_URL=https://maker.ifttt.com/...
